;strokeColor=#9673a6;fillColor=#ffffff;labelPosition=right;align=left;spacingLeft=2;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="ibd-16"><mxGeometry x="167" y="-6" width="12" height="12" as="geometry"/></mxCell><mxCell id="ibd-20" value="assist&lt;br&gt;: ~BrakeAssist" style="rounded=0;html=1;fontSize=9;resizable=0;strokeColor=#9673a6;fillColor=#9673a6;labelPosition=right;align=left;spacingLeft=2;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="ibd-16"><mxGeometry x="124" y="74" width="12" height="12" as="geometry"/></mxCell><mxCell id="ibd-21" value="&lt;b&gt;booster : CargoBrakeBooster&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;van only&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="ibd-2"><mxGeometry x="390" y="530" width="260" height="80" as="geometry"/></mxCell><mxCell id="ibd-22" value="DES-AV" style="text;html=1;align=right;fontSize=10;fontColor=#1a73e8;" vertex="1" parent="ibd-21"><mxGeometry x="164" y="2" width="90" height="16" as="geometry"/></mxCell><mxCell id="ibd-23" value="assist&lt;br&gt;: BrakeAssist" style="rounded=0;html=1;fontSize=9;resizable=0;strokeColor=#9673a6;fillColor=#ffffff;labelPosition=right;align=left;spacingLeft=2;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="ibd-21"><mxGeometry x="124" y="-6" width="12" height="12" as="geometry"/></mxCell><mxCell id="ibd-24" value="&lt;b&gt;supervisor : SafetySupervisor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;src/safety/supervisor.ts&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ibd-2"><mxGeometry x="390" y="70" width="260" height="80" as="geometry"/></mxCell><mxCell id="ibd-25" value="no Design Element" style="text;html=1;align=right;fontSize=10;fontColor=#b85450;" vertex="1" parent="ibd-24"><mxGeometry x="144" y="2" width="110" height="16" as="geometry"/></mxCell><UserObject id="ibd-26" label="↗ Sensor loss response" link="data:page/id,sensor-loss-response"><mxCell style="text;html=1;align=left;fontSize=10;fontColor=#1a73e8;" vertex="1" parent="ibd-24"><mxGeometry x="6" y="2" width="140" height="16" as="geometry"/></mxCell></UserObject><mxCell id="ibd-27" value="sensors&lt;br&gt;: ~HealthMonitor" style="rounded=0;html=1;fontSize=9;resizable=0;strokeColor=#82b366;fillColor=#82b366;labelPosition=right;align=left;spacingLeft=2;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="ibd-24"><mxGeometry x="81" y="74" width="12" height="12" as="geometry"/></mxCell><mxCell id="ibd-28" value="brakes&lt;br&gt;: ~BrakeActuator" style="rounded=0;html=1;fontSize=9;resizable=0;strokeColor=#82b366;fillColor=#82b366;labelPosition=right;align=left;spacingLeft=2;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="ibd-24"><mxGeometry x="167" y="74" width="12" height="12" as="geometry"/></mxCell><mxCell id="ibd-29" value="heightM() · blindZoneRadiusM()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=open;endSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ibd-10" target="ibd-5" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ibd-30" value="fuse()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=open;endSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ibd-14" target="ibd-8" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ibd-31" value="apply() · maxDecelMps2()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=open;endSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ibd-15" target="ibd-18" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="213" y="204"/><mxPoint x="477" y="204"/></Array></mxGeometry></mxCell><mxCell id="ibd-32" value="health()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=open;endSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ibd-27" target="ibd-9" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="230"/><mxPoint x="213" y="230"/></Array></mxGeometry></mxCell><mxCell id="ibd-33" value="apply() · maxDecelMps2()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=open;endSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ibd-28" target="ibd-19" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ibd-34" value="assistForceN()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=open;endSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ibd-20" target="ibd-23" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject id="ibd-35" label="↗ Interfaces and items" link="data:page/id,interfaces"><mxCell style="text;html=1;fontSize=11;fontColor=#1a73e8;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="660" width="200" height="20" as="geometry"/></mxCell></UserObject></root></mxGraphModel></diagram><diagram id="interfaces" name="Interfaces and items"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="interfaces-1" value="Port types list the operations their provider offers. Items are the data that crosses ports." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="-40" width="900" height="30" as="geometry"/></mxCell><UserObject id="interfaces-2" label="↩ Parts and interfaces (IBD)" link="data:page/id,ibd"><mxCell style="text;html=1;fontSize=11;fontColor=#1a73e8;align=left;" vertex="1" parent="1"><mxGeometry x="920" y="-40" width="220" height="20" as="geometry"/></mxCell></UserObject><mxCell id="interfaces-3" value="&lt;font color=&quot;#666666&quot;&gt;«interface»&lt;/font&gt; &lt;b&gt;ObjectSource&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Fused perception output, one frame at a time.&lt;/font&gt;&lt;hr&gt;fuse(frame: SensorFrame): ObjectList" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="300" height="69" as="geometry"/></mxCell><mxCell id="interfaces-4" value="&lt;font color=&quot;#666666&quot;&gt;«interface»&lt;/font&gt; &lt;b&gt;HealthMonitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Per-sensor health for the safety supervisor.&lt;/font&gt;&lt;hr&gt;health(nowMs: Real): SensorHealth[*]" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="0" width="300" height="69" as="geometry"/></mxCell><mxCell id="interfaces-5" value="&lt;font color=&quot;#666666&quot;&gt;«interface»&lt;/font&gt; &lt;b&gt;MountGeometry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Lidar mounting geometry the fusion module is calibrated for.&lt;/font&gt;&lt;hr&gt;heightM(): Real&lt;br&gt;blindZoneRadiusM(): Real" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="660" y="0" width="300" height="84" as="geometry"/></mxCell><mxCell id="interfaces-6" value="&lt;font color=&quot;#666666&quot;&gt;«interface»&lt;/font&gt; &lt;b&gt;BrakeActuator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Deceleration commands to the brake controller.&lt;/font&gt;&lt;hr&gt;apply(cmd: BrakeCommand): BrakeResponse&lt;br&gt;maxDecelMps2(): Real" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="0" width="300" height="84" as="geometry"/></mxCell><mxCell id="interfaces-7" value="&lt;font color=&quot;#666666&quot;&gt;«interface»&lt;/font&gt; &lt;b&gt;BrakeAssist&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Extra brake force from an assist unit.&lt;/font&gt;&lt;hr&gt;assistForceN(massKg: Real, channelsOk: Real): Real" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="93" width="300" height="69" as="geometry"/></mxCell><mxCell id="interfaces-8" value="&lt;font color=&quot;#666666&quot;&gt;«item»&lt;/font&gt; &lt;b&gt;SensorFrame&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;All detections captured at one instant.&lt;/font&gt;&lt;hr&gt;captureMs: Real&lt;br&gt;detections: Detection[*]" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="93" width="300" height="84" as="geometry"/></mxCell><mxCell id="interfaces-9" value="&lt;font color=&quot;#666666&quot;&gt;«item»&lt;/font&gt; &lt;b&gt;Detection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;One raw detection from one sensor, in vehicle coordinates.&lt;/font&gt;&lt;hr&gt;sensor: SensorId&lt;br&gt;x: Real&lt;br&gt;y: Real&lt;br&gt;label: ObjectClass?&lt;br&gt;heightM: Real?&lt;br&gt;speedMps: Real?&lt;br&gt;inCrosswalk: Boolean?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="660" y="108" width="300" height="159" as="geometry"/></mxCell><mxCell id="interfaces-10" value="&lt;font color=&quot;#666666&quot;&gt;«item»&lt;/font&gt; &lt;b&gt;ObjectList&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;The fused object list published to the planner.&lt;/font&gt;&lt;hr&gt;captureMs: Real&lt;br&gt;publishMs: Real&lt;br&gt;objects: TrackedObject[*]" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="108" width="300" height="99" as="geometry"/></mxCell><mxCell id="interfaces-11" value="&lt;font color=&quot;#666666&quot;&gt;«item»&lt;/font&gt; &lt;b&gt;TrackedObject&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;A fused, classified object.&lt;/font&gt;&lt;hr&gt;x: Real&lt;br&gt;y: Real&lt;br&gt;cls: ObjectClass&lt;br&gt;sensors: SensorId[*]&lt;br&gt;inCrosswalk: Boolean?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="186" width="300" height="129" as="geometry"/></mxCell><mxCell id="interfaces-12" value="&lt;font color=&quot;#666666&quot;&gt;«item»&lt;/font&gt; &lt;b&gt;SensorHealth&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Whether one sensor reported recently.&lt;/font&gt;&lt;hr&gt;sensor: SensorId&lt;br&gt;ok: Boolean&lt;br&gt;atMs: Real" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="201" width="300" height="99" as="geometry"/></mxCell><mxCell id="interfaces-13" value="&lt;font color=&quot;#666666&quot;&gt;«enum»&lt;/font&gt; &lt;b&gt;ObjectClass&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;What a tracked object is.&lt;/font&gt;&lt;hr&gt;pedestrian&lt;br&gt;cyclist&lt;br&gt;vehicle&lt;br&gt;animal&lt;br&gt;static" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="231" width="300" height="129" as="geometry"/></mxCell><mxCell id="interfaces-14" value="&lt;font color=&quot;#666666&quot;&gt;«enum»&lt;/font&gt; &lt;b&gt;SensorId&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;The perception sensors.&lt;/font&gt;&lt;hr&gt;camera-front&lt;br&gt;lidar-primary&lt;br&gt;radar-front&lt;br&gt;radar-rear" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="660" y="291" width="300" height="114" as="geometry"/></mxCell><mxCell id="interfaces-15" value="&lt;font color=&quot;#666666&quot;&gt;«item»&lt;/font&gt; &lt;b&gt;BrakeCommand&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;A requested deceleration and why.&lt;/font&gt;&lt;hr&gt;decelMps2: Real&lt;br&gt;reason: BrakeReason" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="324" width="300" height="84" as="geometry"/></mxCell><mxCell id="interfaces-16" value="&lt;font color=&quot;#666666&quot;&gt;«enum»&lt;/font&gt; &lt;b&gt;BrakeReason&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Why braking was requested.&lt;/font&gt;&lt;hr&gt;stop&lt;br&gt;yield&lt;br&gt;geofence&lt;br&gt;mrc&lt;br&gt;slow" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="339" width="300" height="129" as="geometry"/></mxCell><mxCell id="interfaces-17" value="&lt;font color=&quot;#666666&quot;&gt;«item»&lt;/font&gt; &lt;b&gt;BrakeResponse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;The deceleration delivered, healthy channels and hazard lights.&lt;/font&gt;&lt;hr&gt;decelMps2: Real&lt;br&gt;channelsOk: Real&lt;br&gt;hazards: Boolean" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="384" width="300" height="99" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="planning-cycle" name="Planning cycle"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="planning-cycle-1" label="↩ Parts and interfaces (IBD)" link="data:page/id,ibd"><mxCell style="text;html=1;fontSize=11;fontColor=#1a73e8;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="-50" width="220" height="20" as="geometry"/></mxCell></UserObject><mxCell id="planning-cycle-2" value="A behavior of MotionPlanner. One planning step: perceive, then yield, stop at the geofence or cruise under the governor. Actions show the operation, the part that performs it and the port it is called through." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="240" y="-50" width="640" height="34" as="geometry"/></mxCell><mxCell id="planning-cycle-3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="244" y="36" width="32" height="32" as="geometry"/></mxCell><mxCell id="planning-cycle-4" value="&lt;b&gt;fuse&lt;/b&gt;&lt;br&gt;(SensorFusion)&lt;br&