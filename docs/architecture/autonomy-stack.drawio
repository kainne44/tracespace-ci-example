<mxfile host="code-model"><diagram id="ibd" name="Parts and interfaces (IBD)"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ibd-1" value="Parts are &lt;b&gt;name : Type&lt;/b&gt;. Ports are &lt;b&gt;name : PortType&lt;/b&gt;; ~ marks the side that calls. Each connector joins a port type to its conjugate and is labeled with the operations called across it (arrow toward the provider). Labels like DES-AT name the Trace.Space Design Element the part implements." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="-50" width="690" height="40" as="geometry"/></mxCell><mxCell id="ibd-2" value="&lt;b&gt;stack : AutonomyStack&lt;/b&gt;&lt;br&gt;src/stack.ts" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="690" height="640" as="geometry"/></mxCell><mxCell id="ibd-3" value="&lt;b&gt;mount : LidarMount&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;src/perception/lidar-mount.ts&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#333333;dashed=1;" vertex="1" parent="ibd-2"><mxGeometry x="40" y="530" width="260" height="80" as="geometry"/></mxCell><mxCell id="ibd-4" value="DES-AQ" style="text;html=1;align=right;fontSize=10;fontColor=#1a73e8;" vertex="1" parent="ibd-3"><mxGeometry x="164" y="2" width="90" height="16" as="geometry"/></mxCell><mxCell id="ibd-5" value="geometry&lt;br&gt;: MountGeometry" style="rounded=0;html=1;fontSize=9;resizable=0;strokeColor=#333333;fillColor=#ffffff;labelPosition=right;align=left;spacingLeft=2;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="ibd-3"><mxGeometry x="124" y="-6" width="12" height="12" as="geometry"/></mxCell><mxCell id="ibd-6" value="&lt;b&gt;fusion : SensorFusion&lt;/b&gt;&lt;br&gt;&lt;